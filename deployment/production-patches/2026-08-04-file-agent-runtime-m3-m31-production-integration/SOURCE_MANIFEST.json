{
  "schema_version": 1,
  "batch": "file-agent-runtime-m3-m31-production-integration",
  "status": "development_only",
  "scope": [
    "word-edit-v1",
    "xlsx-edit-v1",
    "pptx-edit-v1",
    "office-compose-v1",
    "LibreChat-API",
    "file-agent-runtime"
  ],
  "runtime": {
    "service": "file-agent-runtime",
    "internal_port": 8790,
    "health_path": "/healthz",
    "host_ports": [],
    "data_volume": "file-agent-runtime-data",
    "image_policy": "immutable digest reference required",
    "codeapi_host": "codeapi",
    "codeapi_port": 8000,
    "max_concurrent_tasks": 1
  },
  "api": {
    "service": "api",
    "connector_root": "/opt/librechat/file-agent-runtime/connector",
    "runtime_base_url": "http://file-agent-runtime:8790",
    "feature_flag": "FILE_AGENT_RUNTIME_ENABLED",
    "default_feature_flag": "false"
  },
  "connector_archive": {
    "producer": "scripts/package-connector-archive.py",
    "source_root": "services/librechat-file-agent-connector",
    "included_paths": [
      "package.json",
      "src/**"
    ],
    "acceptance_contract_root": "src/acceptance-contracts",
    "api_mount": "/opt/librechat/file-agent-runtime/connector"
  },
  "runtime_build": {
    "node_base_policy": "digest pinned",
    "debian_snapshot": "20260702T000000Z",
    "debian_suites": ["bookworm", "bookworm-updates", "bookworm-security"],
    "debian_architecture": "amd64",
    "apt_lock": "services/file-agent-runtime/apt-packages.lock",
    "apt_index_verifier": "scripts/verify-apt-snapshot.py",
    "apt_locked_versions": {
      "libreoffice-calc": "4:7.4.7-1+deb12u13",
      "libreoffice-impress": "4:7.4.7-1+deb12u13",
      "libreoffice-writer": "4:7.4.7-1+deb12u13"
    },
    "apt_index_sha256": {
      "bookworm": "62d555a3a8be1d6de520fcd497ae85f2317c6dbb1249976e07720043e77b85d8",
      "bookworm-updates": "87e7e94047fb7fb6f4ceecc7022d4bee55b66031cc2a7666d3196f3e0aabb846",
      "bookworm-security": "7d6bede61fbab39ad6aa61bdcaff2dbe1649187352ff2f2950d4ec5aed189f8a"
    },
    "python_lock": "services/file-agent-runtime/requirements.lock"
  },
  "secrets": {
    "file-agent-service-scope": "API and Runtime HMAC scope secret file",
    "file-agent-allowlist": "API user allowlist file",
    "file-agent-model-api-key": "Runtime model relay API key file"
  },
  "rollback_scope": [
    "api",
    "file-agent-runtime",
    "compose.override.yaml",
    "new release-scoped Connector directory"
  ],
  "protected_services": [
    "LibreChat-NGINX",
    "LibreChat-CodeAPI",
    "LibreChat-RAG-API",
    "LibreChat-Admin-Panel",
    "chat-mongodb"
  ],
  "stop_conditions": [
    "missing explicit enable_runtime=true handoff",
    "runtime image is not pinned by sha256 digest",
    "secret or allowlist host file is missing or unreadable",
    "Compose baseline or container identity drifted after preflight",
    "Runtime has a host port, public route, or CodeAPI data mount",
    "API or Runtime health check fails",
    "native API health/fallback check fails"
  ]
}
