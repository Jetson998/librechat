ARG LIBRECHAT_API_IMAGE=registry.librechat.ai/danny-avila/librechat-dev-api@sha256:3dfdcecc87a020983c2053f557c33072008a2d9e3ebf3268525e7022a7ea548b
FROM ${LIBRECHAT_API_IMAGE}

USER root

# The production API uses these three exact captured files as read-only mounts;
# they are not guaranteed to be present inside the public API image referenced
# above. Install the reviewed baseline copies first, then apply the File Agent
# overlay. verify-api-overlay.py checks their source hashes before this build.
COPY deployment/production-patches/2026-08-01-diagnostic-log-backend/backend/overlay/api/models/index.js /app/api/models/index.js
COPY deployment/production-patches/2026-08-01-diagnostic-log-backend/backend/overlay/api/server/routes/index.js /app/api/server/routes/index.js
COPY deployment/production-patches/2026-08-01-diagnostic-log-backend/backend/overlay/api/server/routes/admin/diagnosticEvents.js /app/api/server/routes/admin/diagnosticEvents.js
COPY deployment/production-patches/2026-08-01-diagnostic-log-backend/backend/overlay/api/server/services/DiagnosticEvents.js /app/api/server/services/DiagnosticEvents.js
COPY services/librechat-file-agent-connector/production-overlay/api/baseline/api/server/index.js /app/api/server/index.js
COPY services/librechat-file-agent-connector/production-overlay/api/baseline/api/server/controllers/agents/request.js /app/api/server/controllers/agents/request.js
COPY services/librechat-file-agent-connector/production-overlay/api/baseline/api/server/routes/agents/chat.js /app/api/server/routes/agents/chat.js
COPY deployment/production-patches/2026-07-31-office-preparse-result-contract-fix/office-context-patch/InitializationFailure.js /app/api/server/controllers/agents/InitializationFailure.js

RUN node -e 'const fs=require("node:fs");const crypto=require("node:crypto");const expected={"/app/api/models/index.js":"37cf0b99c1d92719ef7f6b9ffe78216813d6193aa91044ad1376603fa9b90505","/app/api/server/index.js":"6c24bc39d97a78caaa47dfe4b8ab510dcd385254b615c7e92ac9e8e4c3381cf1","/app/api/server/controllers/agents/request.js":"eb0ba1cb054951dcd653014753884fed9f1f1cd1d9ffcf444a749ece34df6c9f","/app/api/server/controllers/agents/InitializationFailure.js":"547bd84e25b136148cd12582e900c6b41ab85170b909b01bd14a7c37b0e78abd","/app/api/server/routes/index.js":"67544339303e0280ec944e18bc2f0967462c45cd99685013cb192383e099a474","/app/api/server/routes/admin/diagnosticEvents.js":"12ba3dee71a2584a0f5c6d65e960f4139c5494e2b7e1e7d001b88c747df28fd1","/app/api/server/routes/agents/chat.js":"f77d6ff5279e7b172d53bca04f85978b30ce2f4f5d2dcbceb036b46e0c4e42a3","/app/api/server/services/DiagnosticEvents.js":"c60f930fb6f24d5802c2249650d1557c4de4cbdfbbe09263cf05785be9467934"};for(const [file,digest] of Object.entries(expected)){const actual=crypto.createHash("sha256").update(fs.readFileSync(file)).digest("hex");if(actual!==digest)throw new Error(`${file} captured baseline mismatch: ${actual}`)}'

COPY services/librechat-file-agent-connector/production-overlay/api/overlay/api/server/index.js /app/api/server/index.js
COPY services/librechat-file-agent-connector/production-overlay/api/overlay/api/server/controllers/agents/request.js /app/api/server/controllers/agents/request.js
COPY services/librechat-file-agent-connector/production-overlay/api/overlay/api/server/routes/agents/chat.js /app/api/server/routes/agents/chat.js
COPY services/librechat-file-agent-connector/production-overlay/api/server/services/FileAgentRuntime.js /app/api/server/services/FileAgentRuntime.js
COPY deployment/production-patches/2026-08-04-file-agent-runtime-m3-m31-production-integration/integration/api/startup-marker.cjs /opt/file-agent-integration/startup-marker.cjs
COPY deployment/production-patches/2026-08-04-file-agent-runtime-m3-m31-production-integration/integration/config/api-overlay-manifest.json /opt/file-agent-integration/api-overlay-manifest.json

RUN node -e 'const fs=require("node:fs");const crypto=require("node:crypto");const expected={"/app/api/server/index.js":"d8e160aff8b5719120f65119f8ad5338e8563190374cb607fed2f3b848f04ec3","/app/api/server/controllers/agents/request.js":"7e0f1915530b90addd4424ff0dce128af98ad86037bef8fa1aeb4db03f1dc3e9","/app/api/server/routes/agents/chat.js":"03ee373d681c012ac1a0efbfa18043a128567d6512f2f52358f8ba0318c71ee1","/app/api/server/services/FileAgentRuntime.js":"692962021cbf1e1c9b946a9f42e8ac26f4a46513a2e043d5714dc3fe92704d20"};for(const [file,digest] of Object.entries(expected)){const actual=crypto.createHash("sha256").update(fs.readFileSync(file)).digest("hex");if(actual!==digest)throw new Error(`${file} overlay mismatch: ${actual}`)}'

RUN chmod 0444 \
      /app/api/models/index.js \
      /app/api/server/index.js \
      /app/api/server/controllers/agents/request.js \
      /app/api/server/controllers/agents/InitializationFailure.js \
      /app/api/server/routes/index.js \
      /app/api/server/routes/admin/diagnosticEvents.js \
      /app/api/server/routes/agents/chat.js \
      /app/api/server/services/DiagnosticEvents.js \
      /app/api/server/services/FileAgentRuntime.js \
      /opt/file-agent-integration/startup-marker.cjs \
      /opt/file-agent-integration/api-overlay-manifest.json

LABEL org.opencontainers.image.title="LibreChat API file-agent integration harness" \
      org.opencontainers.image.source="https://github.com/Jetson998/LibreChat" \
      org.opencontainers.image.description="Non-production API image with the reviewed File Agent overlay"

ENV NODE_OPTIONS=--require=/opt/file-agent-integration/startup-marker.cjs
ENV FILE_AGENT_INTEGRATION_API_MARKER=/tmp/file-agent-integration-api-overlay.json
ENV FILE_AGENT_INTEGRATION_API_OVERLAY_MANIFEST=/opt/file-agent-integration/api-overlay-manifest.json

USER node
WORKDIR /app
EXPOSE 3080
CMD ["node", "api/server/index.js"]
