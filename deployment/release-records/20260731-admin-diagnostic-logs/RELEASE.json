  "change_summary": {
    "expected_result": "The Admin Panel exposes a protected diagnostic logs page at /logs without changing LibreChat chat, API, MongoDB, Office, CodeAPI, or Nginx behavior.",
    "functions": [
      "Add a Diagnostic logs item to the Admin Panel sidebar and command menu",
      "Add a permission-gated /logs route with filters, summary fields, and a result table shell",
      "Document the diagnostic event API, privacy boundary, retention, and indexes"
    ],
    "limitations": [
      "The diagnostic event API is not part of this release, so the page explicitly shows an unavailable state and no fabricated rows",
      "The page temporarily reuses read:audit_log until a dedicated read:diagnostic_logs capability is implemented"
    ],
    "reason": "Provide an administrator-facing entry point for the planned runtime diagnostic logs and a stable UI contract for the backend event endpoint.",
