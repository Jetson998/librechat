+import React from 'react';
+import { render, screen } from '@testing-library/react';
+import '@testing-library/jest-dom/extend-expect';
+import { Bot, MessagesSquare } from 'lucide-react';
+import type { NavLink } from '~/common';
+import { ActivePanelProvider } from '~/Providers/ActivePanelContext';
+import Nav from './Nav';
+
+function ConversationsPanel() {
+  return <div>conversation-panel</div>;
+}
+
+describe('SidePanel Nav', () => {
+  beforeEach(() => {
+    localStorage.clear();
+  });
+
+  it('keeps valid panel content when a route command is visually active', () => {
+    const links: NavLink[] = [
+      {
+        title: 'com_ui_chat_history',
+        icon: MessagesSquare,
+        id: 'conversations',
+        Component: ConversationsPanel,
+      },
+      {
+        title: 'com_agents_workspace',
+        icon: Bot,
+        id: 'agents-workspace',
+        isActive: true,
+        onClick: jest.fn(),
+      },
+    ];
+
+    render(
+      <ActivePanelProvider>
+        <Nav links={links} />
+      </ActivePanelProvider>,
+    );
+
+    expect(screen.getByText('conversation-panel')).toBeInTheDocument();
+  });
+});
