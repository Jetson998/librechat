+import en from './en/translation.json';
+import zhHans from './zh-Hans/translation.json';
+
+const workspaceKeys = [
+  'com_agents_workspace',
+  'com_agents_workspace_recommended',
+  'com_agents_workspace_mine',
+  'com_agents_workspace_create',
